# ---------- Database ----------
# Postgres (docker compose up -d). If DATABASE_URL is unset, the app falls back
# to an embedded PGlite database stored in ./.pglite (handy when Docker isn't available).
DATABASE_URL=postgres://pricevue:pricevue@localhost:5432/pricevue
# PGLITE_DATA_DIR=./.pglite

# ---------- Queue ----------
REDIS_URL=redis://localhost:6379

# ---------- Site ----------
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ---------- Amazon (Creators API) ----------
# All outbound Amazon links carry this Associates tag.
AMAZON_ASSOCIATE_TAG=pricevue-21
AMAZON_MARKETPLACE=www.amazon.in
# Credentials from Associates Central > Creators API (OAuth2 client credentials). Leave blank to
# skip Amazon refreshes ("Amazon API not configured"). Never scrape amazon.in.
AMAZON_CREATORS_API_CREDENTIAL_ID=
AMAZON_CREATORS_API_CREDENTIAL_SECRET=
# Credential version: 3.2 = EU token endpoint (covers amazon.in); 3.1 = NA, 3.3 = FE.
AMAZON_CREATORS_API_VERSION=3.2

# ---------- Flipkart ----------
FLIPKART_AFFILIATE_ID=
FLIPKART_AFFILIATE_TOKEN=
# Scraper fallback is disabled by default; never enabled in tests.
FLIPKART_SCRAPER_ENABLED=false

# ---------- Auth (Auth.js / NextAuth v5) ----------
# Required in production: generate with `openssl rand -base64 32`. Dev falls back to an insecure default.
AUTH_SECRET=
# Google OAuth (optional; Google sign-in is hidden when unset). Redirect URI:
# http://localhost:3000/api/auth/callback/google
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=
# Magic-link email via Resend. When unset, sign-in links are printed to the server console.
AUTH_RESEND_KEY=
AUTH_EMAIL_FROM="PriceVue <login@pricevue.in>"

# ---------- Price alerts (worker) ----------
# Price-drop emails reuse AUTH_RESEND_KEY unless ALERTS_RESEND_KEY is set; with neither, alerts are logged.
ALERTS_RESEND_KEY=
ALERTS_EMAIL_FROM="PriceVue Alerts <alerts@pricevue.in>"
# Signs one-click unsubscribe links; falls back to AUTH_SECRET. Must match between web and worker.
ALERTS_SECRET=

# ---------- Admin ----------
# Comma-separated emails allowed to use /admin/* (match review). Everyone else gets a 404.
ADMIN_EMAILS=

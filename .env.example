# ---------- Database ----------
# Postgres (docker compose up -d). If DATABASE_URL is unset, the app falls back
# to an embedded PGlite database stored in ./.pglite (handy when Docker isn't available).
DATABASE_URL=postgres://pricevue:pricevue@localhost:5432/pricevue
# PGLITE_DATA_DIR=./.pglite

# ---------- Queue ----------
REDIS_URL=redis://localhost:6379

# ---------- Site ----------
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ---------- Amazon (Creators API) ----------
# All outbound Amazon links carry this Associates tag.
AMAZON_ASSOCIATE_TAG=pricevue-21
AMAZON_MARKETPLACE=www.amazon.in
AMAZON_CREATORS_API_CREDENTIAL_ID=
AMAZON_CREATORS_API_CREDENTIAL_SECRET=
AMAZON_CREATORS_API_VERSION=

# ---------- Flipkart ----------
FLIPKART_AFFILIATE_ID=
FLIPKART_AFFILIATE_TOKEN=
# Scraper fallback is disabled by default; never enabled in tests.
FLIPKART_SCRAPER_ENABLED=false
